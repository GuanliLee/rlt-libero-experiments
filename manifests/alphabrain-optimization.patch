diff --git a/tests/test_rlt_td3_regressions.py b/tests/test_rlt_td3_regressions.py
new file mode 100644
index 0000000..cdbcefc
--- /dev/null
+++ b/tests/test_rlt_td3_regressions.py
@@ -0,0 +1,188 @@
+"""CPU regressions for TD3 failures found while auditing the released RLT_a.
+
+Load the actual production functions/loop with AST so these tests do not import
+the VLA, model registry, renderer, or optional training integrations.
+Run: python -m unittest discover -s tests -p 'test_rlt_td3_regressions.py' -v
+"""
+
+import ast
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+import torch
+
+
+ROOT = Path(__file__).resolve().parents[1]
+RL = ROOT / "AlphaBrain/training/reinforcement_learning"
+DRIVER = RL / "trainers/train_rl_offpolicy.py"
+UPDATES = RL / "algos/RLT_a/action_token_trainer.py"
+
+
+def load_function(path, name, namespace=None):
+    tree = ast.parse(path.read_text())
+    function = next(node for node in tree.body
+                    if isinstance(node, ast.FunctionDef) and node.name == name)
+    module = ast.Module(body=[
+        ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+        function,
+    ], type_ignores=[])
+    namespace = {} if namespace is None else namespace
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+    return namespace[name]
+
+
+spec = importlib.util.spec_from_file_location("rlt_replay", RL / "common/replay_buffer.py")
+replay_module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(replay_module)
+
+
+class TD3Regressions(unittest.TestCase):
+    def test_delayed_actor_updates_across_single_update_batches(self):
+        tree = ast.parse(DRIVER.read_text())
+        loop = next(node for node in ast.walk(tree)
+                    if isinstance(node, ast.For)
+                    and isinstance(node.target, ast.Name) and node.target.id == "td_step")
+        code = compile(ast.Module(body=[loop], type_ignores=[]), str(DRIVER), "exec")
+
+        class CountingSGD(torch.optim.SGD):
+            def __init__(self, parameters):
+                super().__init__(parameters, lr=0.05)
+                self.steps = 0
+
+            def step(self, *args, **kwargs):
+                self.steps += 1
+                return super().step(*args, **kwargs)
+
+        actor = torch.nn.Linear(1, 1, bias=False)
+        critic = torch.nn.Linear(1, 1, bias=False)
+        torch.nn.init.zeros_(actor.weight)
+        actor_optimizer = CountingSGD(actor.parameters())
+        critic_optimizer = CountingSGD(critic.parameters())
+        target_updates = []
+
+        def critic_update(**kwargs):
+            loss = (kwargs["q_critic"].weight - 0.5).square().sum()
+            return loss, {"critic_loss": loss.item()}
+
+        def actor_update(**kwargs):
+            loss = (kwargs["actor"].weight - 1).square().sum()
+            return loss, {"actor_loss": loss.item()}
+
+        namespace = dict(
+            torch=torch, n_updates=1, td_global_step=0, actor=actor, q_critic=critic,
+            optimizer_actor=actor_optimizer, optimizer_critic=critic_optimizer,
+            args=SimpleNamespace(gamma=0.99, target_noise_std=0.2,
+                                 target_noise_clip=0.5, max_grad_norm=1.0,
+                                 actor_update_freq=2, beta=1.0, tau=0.005,
+                                 _selected_task_ids=None),
+            target_q_critic=object(), target_actor=object(), replay_buffer=object(),
+            batch_sz=2, actor_chunk_len=8, train_device="cpu", n_tasks_for_balance=0,
+            action_token_td_critic_update=critic_update,
+            action_token_td_actor_update=actor_update,
+            soft_update_target=lambda *a, **k: target_updates.append((a, k)),
+            td_stats_list=[],
+        )
+        for _ in range(20):
+            exec(code, namespace)
+        self.assertEqual(critic_optimizer.steps, 20)
+        self.assertEqual(actor_optimizer.steps, 10)
+        self.assertEqual(namespace["td_global_step"], 20)
+        self.assertEqual(len(target_updates), 20)  # actor + critic, ten times each
+        self.assertGreater(actor.weight.item(), 0)
+
+    def test_td_target_is_invariant_to_unrelated_batch_reward(self):
+        captured_targets = []
+
+        def mse_loss(predicted, target):
+            captured_targets.append(target.clone())
+            return torch.nn.functional.mse_loss(predicted, target)
+
+        update = load_function(UPDATES, "action_token_td_critic_update", {
+            "torch": torch, "F": SimpleNamespace(mse_loss=mse_loss),
+        })
+
+        class Buffer:
+            def __init__(self, second_reward):
+                self.rewards = torch.tensor([0.0, float(second_reward)])
+
+            def sample(self, batch_size, device):
+                token = torch.zeros(2, 1, 256)
+                action = torch.zeros(2, 8, 7)
+                prop = torch.zeros(2, 8)
+                return (token, action, action, self.rewards, token, action,
+                        torch.tensor([0.0, 1.0]), prop, prop)
+
+        class Actor:
+            def __call__(self, token, action, prop, deterministic):
+                return action, None
+
+        class Critic:
+            def __init__(self, value):
+                self.value = value
+
+            def __call__(self, token, action, prop):
+                q = torch.full((len(token),), self.value, dtype=torch.float32)
+                return q, q
+
+        first_targets = []
+        for second_reward in (0, 5):
+            captured_targets.clear()
+            update(Actor(), Critic(0), Critic(3), Buffer(second_reward),
+                   batch_size=2, gamma=0.99 ** 8, device="cpu", target_noise_std=0)
+            first_targets.append(captured_targets[0][0].item())
+            self.assertEqual(captured_targets[0][1].item(), second_reward)
+        self.assertAlmostEqual(first_targets[0], 0.99 ** 8 * 3, places=6)
+        self.assertEqual(first_targets[0], first_targets[1])
+
+    def make_buffer(self, task_ids):
+        buffer = replay_module.ReplayBuffer()
+        for task_id in task_ids:
+            for _ in range(8):
+                buffer.push(torch.tensor([float(task_id)]), torch.zeros(8, 7),
+                            torch.zeros(8, 7), 0, torch.zeros(1), torch.zeros(8, 7),
+                            False, task_id=task_id)
+        return buffer
+
+    def test_noncontiguous_task_ids_all_receive_samples(self):
+        buffer = self.make_buffer([1, 5, 6])
+        token, *_ = buffer.sample_balanced(12, n_tasks=3, device="cpu")
+        self.assertEqual(sorted(token.squeeze(-1).tolist()), [1] * 4 + [5] * 4 + [6] * 4)
+
+    def test_explicit_task_ids_exclude_other_replay_tasks(self):
+        buffer = self.make_buffer([0, 1, 5, 6])
+        token, *_ = buffer.sample_balanced(12, n_tasks=3, device="cpu", task_ids=[1, 5, 6])
+        self.assertEqual(sorted(token.squeeze(-1).tolist()), [1] * 4 + [5] * 4 + [6] * 4)
+        with self.assertRaisesRegex(ValueError, "requested task_ids"):
+            buffer.sample_balanced(4, n_tasks=1, device="cpu", task_ids=[9])
+
+    def test_empty_and_dropped_rollouts_stop_training(self):
+        validate = load_function(DRIVER, "_validate_rollout_batch")
+        for episodes in ([], [SimpleNamespace(finish_step=0, env_steps=0)]):
+            with self.assertRaisesRegex(RuntimeError, "no trainable transitions"):
+                validate(episodes, n_pushed=0)
+        validate([SimpleNamespace(finish_step=1, env_steps=8)], n_pushed=1)
+
+    def test_missing_worker_result_raises_after_thread_join(self):
+        tree = ast.parse(DRIVER.read_text())
+        function = next(n for n in ast.walk(tree)
+                        if isinstance(n, ast.FunctionDef) and n.name == "_rollout_thread_fn")
+        parent = next(n for n in ast.walk(function)
+                      if isinstance(n, ast.For) and any(
+                          isinstance(child, ast.Assign) and any(
+                              isinstance(t, ast.Name) and t.id == "missing_gpus"
+                              for t in child.targets)
+                          for child in n.body))
+        start = next(i for i, n in enumerate(parent.body)
+                     if isinstance(n, ast.Assign) and any(
+                         isinstance(t, ast.Name) and t.id == "missing_gpus" for t in n.targets))
+        code = compile(ast.Module(body=parent.body[start:start + 2], type_ignores=[]),
+                       str(DRIVER), "exec")
+        with self.assertRaisesRegex(RuntimeError, "workers failed"):
+            exec(code, {"gpu_task_assignments": {0: [1], 1: [5]}, "gpu_results": {0: []}})
+        exec(code, {"gpu_task_assignments": {0: [1]}, "gpu_results": {0: []}})
+
+
+if __name__ == "__main__":
+    unittest.main()
